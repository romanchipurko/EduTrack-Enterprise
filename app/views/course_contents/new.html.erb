<div class="container py-5 mt-4">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to t('nav.home'), root_path %></li>
      <li class="breadcrumb-item"><%= link_to t('nav.curriculum'), edit_learning_path_path(@learning_path) %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= t('lessons.new', default: 'Создание нового урока') %></li>
    </ol>
  </nav>

  <div class="learning-path-detail-card rounded-4 p-4 p-md-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
      <h2 class="fw-bold m-0"><%= t('lessons.new', default: 'Создание нового урока') %></h2>
    </div>

    <%= render "form", course_content: @course_content %>
  </div>
</div>
