<% form_model = course_content.new_record? ? [@learning_path, course_content] : course_content %>

<%= form_with(model: form_model, local: true, class: "needs-validation") do |f| %>
  
  <div class="row mb-5">
    <div class="col-md-8">
      <%= f.label :title, t('lessons.title'), class: "form-label fw-bold" %>
      <%= f.text_field :title, class: "form-control rounded-3 py-2", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :position, t('lessons.position'), class: "form-label fw-bold" %>
      <%= f.number_field :position, class: "form-control rounded-3 py-2", required: true %>
    </div>
  </div>

  <h4 class="fw-bold mb-3"><%= t('lessons.content') %></h4>
  
  <div id="elements_container" class="mb-4">
    <%= f.fields_for :elements do |element_form| %>
      <%= render "course_contents/elements/element_fields", f: element_form %>
    <% end %>
  </div>

  <%= render 'course_contents/quizzes_manager', course_content: course_content %>

  <div class="d-flex justify-content-center p-4 border rounded-4 bg-light mb-4 border-dashed">
    <div class="dropdown">
      <button class="btn btn-outline-primary dropdown-toggle rounded-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-plus-circle me-1"></i> <%= t('lessons.add_element') %>
      </button>
      
      <ul class="dropdown-menu shadow-sm border-0 rounded-3">
        <li><button type="button" class="dropdown-item py-2" onclick="addNestedElement('video')"><%= t('elements.types.video') %></button></li>
        <li><button type="button" class="dropdown-item py-2" onclick="addNestedElement('markdown')"><%= t('elements.types.markdown') %></button></li>
        <li><button type="button" class="dropdown-item py-2" onclick="addNestedElement('code')"><%= t('elements.types.code') %></button></li>
        <li><button type="button" class="dropdown-item py-2" onclick="addNestedElement('asset')"><%= t('elements.types.asset') %></button></li>
      </ul>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-3 pt-3 border-top">
    <% cancel_path = course_content.new_record? ? edit_learning_path_path(@learning_path) : edit_learning_path_path(course_content.learning_path_id) %>
    <%= link_to t('common.cancel'), cancel_path, class: "btn btn-outline-secondary px-4 rounded-3" %>
    <%= f.submit t('common.save_lesson', default: 'Сохранить урок'), class: "btn btn-primary px-4 rounded-3 shadow-sm" %>
  </div>

  <%= render 'course_contents/js_templates', f: f %>

<% end %>

<script>
  function addNestedElement(type) {
    const template = document.getElementById(`template_${type}`);
    if (!template) return;

    const container = document.getElementById('elements_container');
    const time = new Date().getTime();
    let content = template.innerHTML.replace(/NEW_RECORD/g, time);
    
    container.insertAdjacentHTML('beforeend', content);
  }
</script>
