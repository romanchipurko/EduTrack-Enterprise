<div class="container learning-paths-page pb-5">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to t('learning_paths.show.breadcrumb_all'), learning_paths_path %></li>
          <li class="breadcrumb-item active" aria-current="page"><%= @learning_path.title %></li>
        </ol>
      </nav>

      <div class="card learning-path-detail-card border-0 shadow-sm rounded-4 p-4 mb-5">
        <% cache ["learning_path_header", I18n.locale, @learning_path] do %>
          <h1 class="display-6 fw-bold text-dark"><%= @learning_path.title %></h1>
          <p class="text-muted fs-5 mt-3"><%= @learning_path.description %></p>
        <% end %>

        <div class="mt-4">
          <% if @enrollment %>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="small text-muted fw-bold text-uppercase tracking-wide"><%= t('learning_paths.show.progress') %></span>
              <span class="small text-muted fw-bold"><%= @enrollment.progress_percentage %>%</span>
            </div>
            <div class="progress bg-light custom-progress-container">
              <div class="progress-bar bg-success rounded-pill" role="progressbar"
                   style="width: <%= @enrollment.progress_percentage %>%;"
                   aria-valuenow="<%= @enrollment.progress_percentage %>"
                   aria-valuemin="0" aria-valuemax="100">
              </div>
            </div>
          <% else %>
            <%= button_to t('learning_paths.show.subscribe'), learning_path_enrollments_path(@learning_path), method: :post, class: "btn btn-primary btn-lg rounded-pill px-5 fw-bold" %>
          <% end %>
        </div>
        <hr class="my-4">
        <div class="d-flex gap-3">
          <%= link_to t('learning_paths.show.back_to_list'), learning_paths_path, class: "btn btn-outline-secondary rounded-pill px-4" %>
          <% if policy(@learning_path).update? %>
            <%= link_to t('learning_paths.show.edit_curriculum'), edit_learning_path_path(@learning_path), class: 'btn btn-outline-warning rounded-pill px-4' %>
          <% end %>
        </div>
      </div>

      <div class="course-content-section">
        <h3 class="fw-bold mb-4"><%= t('learning_paths.show.curriculum') %></h3>

        <% if !@enrollment %>
          <div class="alert alert-warning border-0 shadow-sm rounded-4 text-center p-4">
            <h5 class="fw-bold text-dark mt-2"><%= t('learning_paths.show.curriculum_locked_title') %></h5>
            <p class="text-muted mb-3"><%= t('learning_paths.show.curriculum_locked_text') %></p>
          </div>
        <% elsif @learning_path.course_contents.any? %>
          <%= render "course_section" %>
        <% else %>
          <div class="alert alert-secondary border-0 shadow-sm rounded-4 text-center p-4">
            <%= t('learning_paths.show.no_lessons') %>
          </div>
        <% end %>
      </div>

    </div>
  </div>
</div>
