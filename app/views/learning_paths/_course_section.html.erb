<div class="accordion shadow-sm rounded-4" id="courseContentAccordion">
  <% @course_contents.sort_by(&:position).each_with_index do |lesson, index| %>
    <% lesson_completed = @enrollment.item_completed?(item_id: lesson.id) %>
    
    <div class="accordion-item border-0 <%= 'border-bottom' unless index == @course_contents.size - 1 %>">
      <h2 class="accordion-header" id="heading-<%= lesson.id %>">
        <button class="accordion-button <%= 'collapsed' unless index == 0 %> bg-white fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= lesson.id %>" aria-expanded="<%= index == 0 ? 'true' : 'false' %>" aria-controls="collapse-<%= lesson.id %>">
          
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary rounded-pill">
              <%= t('learning_paths.show.lesson_prefix', number: lesson.position) %>
            </span>
            <span><%= lesson.title %></span>
            
            <% if lesson_completed %>
              <i class="bi bi-check-circle-fill text-success" title="<%= t('learning_paths.show.completed') %>"></i>
            <% end %>
          </div>
          
        </button>
      </h2>

      <div id="collapse-<%= lesson.id %>" class="accordion-collapse collapse <%= 'show' if index == 0 %>" aria-labelledby="heading-<%= lesson.id %>" data-bs-parent="#courseContentAccordion">
        <div class="accordion-body bg-light">
          <% lesson.elements.sort_by(&:position).each do |element| %>
            <%= render "course_content", element: element %>
          <% end %>

          <% if lesson.quizzes.any? %>
            <div class="mt-4 pt-3 border-top border-2 border-primary border-opacity-10">
              <h6 class="fw-bold text-muted text-uppercase small tracking-wide mb-3">
                <%= t('quizzes.knowledge_check') %>
              </h6>
              
              <div class="d-flex flex-wrap gap-2">
                <% lesson.quizzes.each do |quiz| %>
                  <% quiz_completed = @enrollment.item_completed?(item_id: quiz.id) %>
                  
                  <%= link_to course_content_quiz_path(lesson, quiz), class: "btn #{quiz_completed ? 'btn-success text-white' : 'btn-outline-primary'} rounded-pill d-inline-flex align-items-center shadow-sm" do %>
                    <i class="bi bi-patch-question-fill me-2"></i> 
                    <%= quiz.title %>
                    <% if quiz_completed %>
                      <i class="bi bi-check2 ms-2"></i>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="mt-4 pt-3 text-end border-top">
            <% if lesson_completed %>
              <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 border border-success border-opacity-25">
                <i class="bi bi-check-all me-1"></i> <%= t('learning_paths.show.lesson_completed') %>
              </span>
            <% else %>
              <%= button_to t('learning_paths.show.submit_and_go_next'), learning_path_enrollments_path(@learning_path, item_id: lesson.id.to_s), method: :post, class: "btn btn-primary rounded-pill px-4 shadow-sm fw-bold" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
