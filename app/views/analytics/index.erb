<div class="container py-5 mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-dark"><%= t('analytics.index.title') %></h1>
    <span class="badge bg-primary rounded-pill px-3 py-2">
      <i class="bi bi-broadcast me-1"></i> <%= t('analytics.index.live_badge') %>
    </span>
  </div>

  <div class="row g-4 mb-5">
    <div class="col-md-6">
      <%= render "top_paths", top_paths: @top_paths %>
    </div>
    <div class="col-md-6">
      <%= render "activity", completions_by_day: @completions_by_day %>
    </div>
  </div>

  <h4 class="mb-3 fw-bold text-dark"><%= t('analytics.index.recent_log_title') %></h4>
  <%= render "recent_events", recent_events: @recent_events %>
</div>
