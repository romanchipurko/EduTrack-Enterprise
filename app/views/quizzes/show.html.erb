<div class="container py-5 mt-4">
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Курс", learning_path_path(@course_content.learning_path_id) %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @quiz.title %></li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card rounded-4 shadow-sm border-0 p-4 p-md-5 mb-5">
        <h2 class="fw-bold text-dark mb-2"><%= @quiz.title %></h2>
        <p class="text-muted mb-4">Вопросов в тесте: <%= @quiz.questions.count %></p>

        <%= render 'quizzes/show_partials/history' if @previous_attempts.any? && !defined?(@user_answer) %>
        <%= render 'quizzes/show_partials/results' if defined?(@score) %>
        <%= render 'quizzes/show_partials/wizard' %>
      </div>
    </div>
  </div>
</div>
