<% percentage = @total > 0 ? (@score.to_f / @total * 100).round : 0 %>

<div class="alert <%= @score == @total ? 'alert-success' : 'alert-info' %> rounded-4 mb-5 p-4 text-center shadow-sm border-0">
  <h4 class="alert-heading fw-bold mb-3">
    <%= t('quizzes.results.your_score', score: @score, total: @total, percentage: percentage) %>
  </h4>
  
  <% if @score == @total %>
    <p class="mb-0"><%= t('quizzes.results.perfect_score') %></p>
  <% else %>
    <p class="mb-0"><%= t('quizzes.results.has_errors') %></p>
  <% end %>
  
  <div class="mt-4">
    <%= link_to t('quizzes.results.retry'), course_content_quiz_path(@course_content, @quiz), class: "btn btn-outline-dark rounded-pill px-4" %>
  </div>
</div>
