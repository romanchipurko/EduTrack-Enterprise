<div class="alert alert-secondary rounded-3 mb-4">
  <h6 class="fw-bold mb-2"><i class="bi bi-clock-history me-1"></i> Ваши предыдущие попытки:</h6>
  <ul class="mb-0 small">
    <% @previous_attempts.each do |attempt| %>
      <li>
        <%= l(attempt.created_at, format: :short) %> — 
        <strong><%= attempt.score %> из <%= attempt.total %></strong> 
        (<%= attempt.percentage %>%)
      </li>
    <% end %>
  </ul>
</div>
