<% is_submitted = defined?(@user_answer) %>

<%= form_with url: submit_course_content_quiz_path(@course_content, @quiz),
              method: :post,
              local: true,
              id: "quiz-form" do |f| %>

  <% @quiz.questions.each_with_index do |question, q_index| %>
    <div class="card mb-4 border-0 bg-light rounded-4 question-step"
         data-step="<%= q_index %>"
         style="<%= 'display: none;' if !is_submitted && q_index > 0 %>">

      <div class="card-body p-4">
        <h5 class="fw-bold mb-4">
          <%= q_index + 1 %>. <%= question.text %>
        </h5>

        <% question.options.each_with_index do |option_text, opt_index| %>

          <%
            input_id = "q_#{question.id}_opt_#{opt_index}"

            user_selected = is_submitted && @user_answer[question.id.to_s] == opt_index.to_s

            is_correct_option = question.correct_answer == opt_index

            label_class = "form-check-label w-100 p-3 border rounded-3 mb-2 quiz-option-label"

            if is_submitted
              if is_correct_option
                label_class += " bg-success bg-opacity-10 border-success fw-bold text-success"
              elsif user_selected
                label_class += " bg-danger bg-opacity-10 border-danger text-danger"
              else
                label_class += " bg-white text-muted"
              end
            else
              label_class += " bg-white"
            end
          %>

          <div class="form-check p-0 position-relative">

            <%= radio_button_tag(
                  "answers[#{question.id}]",
                  opt_index,
                  user_selected,
                  id: input_id,
                  class: "form-check-input visually-hidden quiz-radio",
                  disabled: is_submitted,
                  required: !is_submitted
                ) %>

            <%= label_tag input_id, class: label_class do %>
              <div class="d-flex justify-content-between align-items-center">
                <span><%= option_text %></span>

                <% if is_submitted && is_correct_option %>
                  <i class="bi bi-check-circle-fill fs-5"></i>
                <% elsif is_submitted && user_selected %>
                  <i class="bi bi-x-circle-fill fs-5"></i>
                <% end %>
              </div>
            <% end %>

          </div>

        <% end %>

        <% unless is_submitted %>
          <div class="d-flex justify-content-between mt-4 pt-3 border-top">

            <% if q_index > 0 %>
              <button
                type="button"
                class="btn btn-outline-secondary px-4 rounded-pill"
                onclick="prevStep(<%= q_index %>)">
                <i class="bi bi-arrow-left me-1"></i>
                Назад
              </button>
            <% else %>
              <div></div>
            <% end %>

            <% if q_index < @quiz.questions.count - 1 %>
              <button
                type="button"
                class="btn btn-primary px-4 rounded-pill"
                onclick="nextStep(<%= q_index %>)">
                Далее
                <i class="bi bi-arrow-right ms-1"></i>
              </button>
            <% else %>
              <%= f.submit "Отправить ответы",
                    class: "btn btn-success px-4 rounded-pill fw-bold shadow-sm" %>
            <% end %>

          </div>
        <% end %>

      </div>
    </div>
  <% end %>

<% end %>

<script>
  function nextStep(currentIndex) {
    const currentContainer = document.querySelector(
      `.question-step[data-step="${currentIndex}"]`
    );

    const checkedRadio = currentContainer.querySelector(
      'input[type="radio"]:checked'
    );

    if (!checkedRadio) {
      alert("Пожалуйста, выберите вариант ответа, чтобы продолжить.");
      return;
    }

    currentContainer.style.display = "none";

    const nextContainer = document.querySelector(
      `.question-step[data-step="${currentIndex + 1}"]`
    );

    if (nextContainer) {
      nextContainer.style.display = "block";
    }
  }

  function prevStep(currentIndex) {
    const currentContainer = document.querySelector(
      `.question-step[data-step="${currentIndex}"]`
    );

    currentContainer.style.display = "none";

    const prevContainer = document.querySelector(
      `.question-step[data-step="${currentIndex - 1}"]`
    );

    if (prevContainer) {
      prevContainer.style.display = "block";
    }
  }
</script>
