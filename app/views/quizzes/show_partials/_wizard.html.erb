<%= form_with url: submit_course_content_quiz_path(@course_content, @quiz), method: :post, local: true, id: "quiz-form" do |f| %>
  
  <% @quiz.questions.each_with_index do |question, q_index| %>
    <div class="card mb-4 border-0 bg-light rounded-4 question-step <%= 'd-none' if q_index > 0 %>" data-step="<%= q_index %>">
      
      <div class="card-body p-4">
        <h5 class="fw-bold mb-4"><%= q_index + 1 %>. <%= question.text %></h5>

        <% question.options.each_with_index do |option_text, opt_index| %>
          <% input_id = "q_#{question.id}_opt_#{opt_index}" %>

          <div class="form-check position-relative d-flex align-items-center bg-white border rounded-3 mb-3 px-3 py-3 quiz-option-container transition-base">
            <%= radio_button_tag("answers[#{question.id}]", opt_index, false, id: input_id, class: "form-check-input m-0 me-3") %>
            
            <%= label_tag input_id, class: "form-check-label w-100 m-0 text-dark stretched-link" do %>
              <%= option_text %>
            <% end %>
          </div>
        <% end %>

        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
          <% if q_index > 0 %>
            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" onclick="prevStep(<%= q_index %>)">
              <i class="bi bi-arrow-left me-1"></i> <%= t('common.back') %>
            </button>
          <% else %>
            <div></div>
          <% end %>

          <% if q_index < @quiz.questions.count - 1 %>
            <button type="button" class="btn btn-primary px-4 rounded-pill" onclick="nextStep(<%= q_index %>)">
              <%= t('common.next') %> <i class="bi bi-arrow-right ms-1"></i>
            </button>
          <% else %>
            <%= f.submit t('quizzes.wizard.submit'), class: "btn btn-success px-4 rounded-pill fw-bold shadow-sm" %>
          <% end %>
        </div>

      </div>
    </div>
  <% end %>
<% end %>

<script>
  function nextStep(currentIndex) {
    const currentContainer = document.querySelector(`.question-step[data-step="${currentIndex}"]`);
    const checkedRadio = currentContainer.querySelector('input[type="radio"]:checked');

    if (!checkedRadio) {
      alert("<%= j t('quizzes.wizard.alert_choose') %>");
      return;
    }

    currentContainer.classList.add("d-none");
    const nextContainer = document.querySelector(`.question-step[data-step="${currentIndex + 1}"]`);
    if (nextContainer) nextContainer.classList.remove("d-none");
  }

  function prevStep(currentIndex) {
    const currentContainer = document.querySelector(`.question-step[data-step="${currentIndex}"]`);
    currentContainer.classList.add("d-none");
    
    const prevContainer = document.querySelector(`.question-step[data-step="${currentIndex - 1}"]`);
    if (prevContainer) prevContainer.classList.remove("d-none");
  }

  document.getElementById('quiz-form').addEventListener('submit', function(e) {
    const currentContainer = document.querySelector('.question-step:not(.d-none)');
    const checkedRadio = currentContainer.querySelector('input[type="radio"]:checked');
    
    if (!checkedRadio) {
      e.preventDefault();
      alert("<%= j t('quizzes.wizard.alert_submit') %>");
    }
  });
</script>
