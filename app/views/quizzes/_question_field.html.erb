<div class="card mb-4 border-primary nested-question-form">
  <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
    <span class="fw-bold text-primary">Вопрос</span>
    
    <div class="form-check form-switch m-0">
      <%= f.hidden_field :_destroy, class: 'destroy-flag' %>
      <%= button_tag type: 'button', class: 'btn btn-sm btn-outline-danger border-0', onclick: "this.closest('.nested-question-form').style.display='none'; this.closest('.nested-question-form').querySelector('.destroy-flag').value='1';" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  </div>

  <div class="card-body">
    <div class="mb-3">
      <%= f.label :text, "Текст вопроса", class: "form-label small fw-bold" %>
      <%= f.text_field :text, class: "form-control form-control-sm", required: true %>
    </div>

    <p class="small fw-bold text-muted mb-2">Варианты ответов (отметьте правильный)</p>
    
    <% options = f.object.options.presence || ["", ""] %>

    <div class="options-container" data-object-name="<%= f.object_name %>">
      <% options.each_with_index do |option_text, index| %>
        <div class="input-group mb-2 option-row">
          <div class="input-group-text bg-white">
            <%= f.radio_button :correct_answer, index, class: "form-check-input mt-0", required: true %>
          </div>
          <input type="text" name="<%= f.object_name %>[options][]" value="<%= option_text %>" class="form-control form-control-sm" placeholder="Вариант <%= index + 1 %>" required>
          <button type="button" class="btn btn-outline-danger btn-sm px-3" onclick="removeOption(this)">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      <% end %>
    </div>

    <button type="button" class="btn btn-sm btn-outline-secondary mt-2 add-option-btn" onclick="addOption(this)" style="<%= 'display: none;' if options.size >= 6 %>">
      <i class="bi bi-plus-circle"></i> Добавить вариант
    </button>
  </div>
</div>
